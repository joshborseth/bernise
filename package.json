{
  "name": "bernise",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "prepare": "effect-tsgo patch",
    "typecheck": "tsc --build && tsc -p apps/pet --noEmit",
    "lint": "vp lint --report-unused-disable-directives",
    "fmt": "vp fmt",
    "fmt:check": "vp fmt --check",
    "test": "vp test run",
    "test:watch": "vp test",
    "dev": "bun run --filter @bernise/pet dev",
    "dev:pet": "bun run --filter @bernise/pet dev"
  },
  "devDependencies": {
    "@effect/language-service": "latest",
    "@effect/tsgo": "latest",
    "@types/node": "latest",
    "@typescript/native-preview": "latest",
    "typescript": "latest",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "overrides": {
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.0",
      "onFail": "download"
    }
  },
  "catalog": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.0",
    "vitest": "4.1.11",
    "vite-plus": "0.3.0"
  }
}
